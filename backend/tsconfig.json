{
  "compilerOptions": {
    "target": "ES2020",                    // Сучасна ціль компіляції
    "module": "ESNext",                    // Використовуємо модулі ES
    "moduleResolution": "node",            // Як модулі будуть знайдені (у стилі Node.js)
    "declaration": true,                   // Генерує файли .d.ts для підтримки типів
    "sourceMap": true,                     // Генерує source maps для дебагу
    "outDir": "./dist",                    // Каталог для зібраного коду
    "esModuleInterop": true,               // Покращує сумісність з CommonJS модулями
    "skipLibCheck": true,                  // Пропуск перевірки типів у бібліотеках
    "forceConsistentCasingInFileNames": true // Обов'язкове використання однакових регістрів у назвах файлів
  },
  "include": ["src"],                       // Включаємо всі файли з src
  "exclude": ["node_modules", "dist"]               // Виключаємо node_modules
}
