{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Go Project",
            "type": "shell",
            "command": "cd ./gontroller && go run ./...",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$go"],
            "detail": "Run the Go project"
        },
        {
            "label": "Build Go Project",
            "type": "shell",
            "command": "cd ./gontroller && go build -o ./bin/gontroller/ ./...",
            "group": "build",
            "problemMatcher": ["$go"],
            "detail": "Build the Go project"
        },
        {
            "label": "Test Go Project",
            "type": "shell",
            "command": "cd ./gontroller && go test ./...",
            "group": "test",
            "problemMatcher": ["$go"],
            "detail": "Run tests for the Go project"
        }
    ]
}
