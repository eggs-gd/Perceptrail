@startuml
|Proxy|
start
:Create Schema;
:Initialize SyncWorker and LayoutWorker;
fork
  |SyncWorker|
  :Send request to server;
  repeat
    :Receive streamed object;
    :Write to Items DB;
    :Notify LayoutWorker via MessageChannel;
  repeat while (streaming continues)
end fork

|LayoutWorker|
start
:Receive task from View;
repeat
  :Compute layout/filter in background;
  :Listen to notifications via MessagePort;
  if (New data received) then (yes)
    :Restart computation with new data;
  endif
  :Write results to LayoutDB;
repeat while (View task ongoing)

|View|
start
:Subscribe to LayoutDB;
:Reactively display changes;
:Request new computation via Proxy;
stop
@enduml
