@startuml
package "MQTT Broker" {
    component "MQTT Broker" as mqtt
}

package "Services" {
    component "File Watcher/Importer" as importer
    component "Metadata Service" as metadata
    component "Scaler/Transcoder" as scaler
    component "ML Service" as ml
}

package "Storage" {
    database "Database" as db
    component "File Storage" as storage
}

importer --> mqtt: Publishes new file events
metadata --> mqtt: Publishes metadata processed events
scaler --> mqtt: Publishes scaled/transcoded events
ml --> mqtt: Publishes ML processed events

importer --> storage: Uploads files
metadata --> db: Stores metadata
scaler --> db: Stores transcoded files
ml --> db: Stores ML results

mqtt --> importer: Notifies about new files
mqtt --> metadata: Broadcast new file events
mqtt --> scaler: Broadcast new file events
mqtt --> ml: Broadcast new file events
@enduml
